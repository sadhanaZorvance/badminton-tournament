# Leo Rising Stars Tournament — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# Production values are set in Vercel project settings.

# ── Supabase ───────────────────────────────────────────────
# From Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — used ONLY by /scripts/seed-*.js (Node, not the client).
# Never expose to the browser. Do not prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin PINs (set event-day morning) ─────────────────────
VITE_COURT_ADMIN_PIN=0000
VITE_TOP_ADMIN_PIN=0000

# ── Admin URL slugs (secret URL segments — first auth gate) ─
VITE_COURT_ADMIN_SLUG=court-secret-slug
VITE_TOP_ADMIN_SLUG=top-secret-slug
